# Required
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/ornaq?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# OAuth and image uploads
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Optional payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional admin seed
ADMIN_NAME=Ornaq Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-seeding
ADMIN_PHONE=

# OTP: use mock locally; configure MSG91 or Twilio for live delivery
OTP_MODE=mock
OTP_EXPIRY_MINUTES=5
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional email provider (Resend, Brevo, or SMTP)
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_FROM_NAME=ORNAQ
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
